        {
          "name": "Rollback demo: duplicate member -> 409, nothing saved",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/workspaces/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "workspaces",
                ""
              ]
            },
            "description": "Workspace + members are created in one transaction.atomic(). The duplicate member violates unique_workspace_member, so the whole request rolls back. Run \"List workspaces\" to show no \"Should Not Exist\" workspace.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Should Not Exist\",\n  \"owner\": \"{{user_id}}\",\n  \"members\": [\n    {\n      \"user\": \"{{user2_id}}\",\n      \"role\": \"editor\"\n    },\n    {\n      \"user\": \"{{user2_id}}\",\n      \"role\": \"viewer\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
